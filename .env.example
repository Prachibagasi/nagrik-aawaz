# Django API (used by Vite dev proxy). Default: http://127.0.0.1:8000
VITE_BACKEND_URL=http://127.0.0.1:8000

# Optional: full JSON API base when the dev proxy is not used (e.g. `vite preview` or a static host
# talking to Django on another origin). Example: http://127.0.0.1:8000/api/v1
# If unset, the app uses /api/v1 (relative) and `npm run dev` proxies /api → VITE_BACKEND_URL.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Marketing static site (node server.js) — navbar link
VITE_MARKETING_URL=http://localhost:3001
